{
  "config_version": "constraint-generation-v1",
  "task_schema_version": "constraint-task-v1",
  "seed": 20261007,
  "seed_derivation": "sha256-prefix64-v1",
  "rng": {
    "implementation": "random.Random",
    "version": 2,
    "runtime": ["3.11", "3.12"],
    "module_global_allowed": false
  },
  "grammar": {
    "modulus": 3,
    "domain": [0, 1, 2],
    "variable_count": [3, 6],
    "variable_names": "v0-through-v(n-1)",
    "relation_kinds": ["eq", "neq", "add_mod"],
    "constraint_count": [2, 8],
    "given_count": [1, "n_minus_2"],
    "distinct_operands": true,
    "duplicate_constraint_policy": "reject-after-operand-symmetry-normalization",
    "value_relabeling_symmetry": false
  },
  "composition_partition": {
    "assignment": "set-of-relation-kinds-v1",
    "source": [["eq"], ["neq"], ["add_mod"]],
    "development_targets": [["eq", "neq"], ["eq", "add_mod"], ["neq", "add_mod"]],
    "final_targets": [["eq", "neq", "add_mod"]],
    "source_id_buckets": {
      "algorithm": "sha256-canonical-content-bucket-v1",
      "train": 80,
      "validation": 10,
      "test": 10
    },
    "development_target_use": ["validation", "diagnostic-test"],
    "final_target_use": ["structural-audit", "untouched-test"],
    "lineage_and_content_group_split_closure": true
  },
  "generation": {
    "candidate_index_start": 0,
    "candidate_order": "accepted-candidate-index-ascending",
    "candidate_rng_domain": "dwr-generator-v1",
    "n_sampling": "uniform-inclusive",
    "composition_sampling": "uniform-registered-profile-within-partition",
    "constraint_count_sampling": "uniform-inclusive",
    "constraint_sampling": "uniform-distinct-normalized-eligible-tuples",
    "witness_sampling": "independent-uniform-domain-values",
    "given_count_sampling": "uniform-inclusive",
    "given_variable_sampling": "uniform-distinct",
    "acceptance": "independent-oracle-solution-count-equals-one",
    "target_accepted_per_partition": 300,
    "max_attempts_per_partition": 30000,
    "max_accepted_per_partition": 300
  },
  "canonicalization": {
    "algorithm": "exhaustive-variable-permutations-v1",
    "content_domain": "dwr-content-v1",
    "structure_domain": "dwr-structure-v1",
    "constraint_order_invariant": true,
    "variable_renaming_invariant": true,
    "given_values_in_content_id": true,
    "given_values_in_structure_signature": false,
    "anchor_positions_in_structure_signature": true,
    "actual_operand_symmetries_only": true
  },
  "audit_gate": {
    "min_accepted_groups_per_partition": 100,
    "min_structure_signatures_per_partition": 12,
    "source_id_groups_min": {
      "train": 100,
      "validation": 20,
      "test": 20
    },
    "source_train_min_structure_signatures": 12,
    "min_solution_value_fraction_each_partition": 0.1,
    "min_distinct_given_counts_per_partition": 2,
    "min_interaction_sensitive_fraction_each_partition": 0.25,
    "min_sensitive_examples_per_heldout_signature": 1,
    "require_unique_solution": true,
    "require_two_or_more_unassigned": true,
    "require_deterministic_replay": true,
    "require_model_input_annotation_exclusion": true,
    "cap_wall_seconds": 600,
    "cpu_workers": 1,
    "cap_resident_memory_mib": 1024,
    "cap_behavior": "stop-preserve-partial-mark-incomplete-no-rule-relaxation"
  },
  "artifacts": {
    "encoding": "utf-8-no-bom",
    "task_records": "outside-git",
    "model_input_projection_separately_hashed": true,
    "per_example_outcomes": true,
    "aggregate_report": "docs/task_suitability.md",
    "small_hash_manifest_versioned": true
  }
}
